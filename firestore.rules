// REFERENCE COPY — not the deploy source.
//
// This Firestore project (yolohome-c2ce4, see app/google-services.json) is
// shared between Yolo-Home and YoloAIO — one Firestore database behind
// both apps. The rules file that actually deploys lives at
// ../Yolo-Homes-Android/firestore.rules (wired up via that repo's
// firebase.json + `firebase deploy --only firestore:rules`). This copy is
// kept here purely so YoloAIO's own rules are visible from this repo —
// edit the Yolo-Homes-Android copy (and copy the change back here) rather
// than editing this file in isolation, or the two will drift out of sync.

rules_version = '2';

// Shared by Yolo-Home (apartment app) and YoloAIO (all-in-one).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'developer']
        )
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Shared: user profile (used by BOTH apps) ─────────────────────
    // Outer read/write semantics match Yolo-Home's existing rule exactly.
    // YoloAIO's per-user subcollections live inside.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);

      // YoloAIO private subcollections — owner only.
      match /watchHistory/{tmdbId}      { allow read, write: if isOwner(uid); }
      match /customQuotes/{quoteId}     { allow read, write: if isOwner(uid); }
      match /favoriteWallpapers/{id}    { allow read, write: if isOwner(uid); }
      match /favoriteRingtones/{id}     { allow read, write: if isOwner(uid); }
      match /favoriteTracks/{id}        { allow read, write: if isOwner(uid); }
      match /favoriteBooks/{id}         { allow read, write: if isOwner(uid); }
      match /favoriteHairstyles/{id}    { allow read, write: if isOwner(uid); }
      match /settings/{settingName}     { allow read, write: if isOwner(uid); }
    }

    // ── Yolo-Home: apartment collections (unchanged) ─────────────────
    match /appSettings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /masterFlats/{flatId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /flats/{flatId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /maintenanceSettings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /maintenanceReceipts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /readings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── YoloAIO: chat (1:1 DMs + groups, gated on participants array) ─
    // 1:1 chats are unchanged in shape (chatId = 2-sorted-uid join,
    // isGroup absent). Group chats add isGroup/groupName/groupPhotoUrl/
    // ownerUid/adminUids — adminUids (not ownerUid) is what actually
    // gates admin-only writes. lastRead is a per-participant read cursor
    // used for read-receipt ticks, shared by both chat kinds.
    match /chats/{chatId} {
      // `resource == null ||` guards a genuine Firestore rules gotcha: a
      // get() on a document that doesn't exist yet still evaluates this
      // rule, with `resource` null — dereferencing `resource.data` on a
      // null resource throws a rules evaluation error, which Firestore
      // treats as permission-denied, not "not found". Without this guard,
      // observeChatDoc()'s existence-check for a brand-new (never-
      // messaged) 1:1 conversation throws "Missing or insufficient
      // permissions" instead of just returning "doesn't exist". Safe to
      // allow broadly: a nonexistent doc has no data to leak.
      allow read:   if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      // "Delete chat" (1:1 only) previously had no delete rule at all, so
      // it silently failed at the final chatRef.delete() step — fixed
      // here since we're already touching this exact block. Deliberately
      // excludes groups (members leave via clause 4 below instead of a
      // client being able to delete a whole group).
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants
                     && resource.data.get('isGroup', false) == false;

      allow update: if isSignedIn() && (
        // (1) Any current participant bumps preview/read-cursor fields —
        // covers sending a message (1:1 or group) and marking read.
        // lastRead is restricted to the caller's own key via a nested diff.
        (
          request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastTime','lastRead']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastRead']) ||
            request.resource.data.lastRead.diff(resource.data.get('lastRead', {})).affectedKeys().hasOnly([request.auth.uid])
          )
        ) ||
        // (2) Admin renames / re-photos / edits the admin roster — never
        // touches participants here. New admins must already be confirmed
        // participants (blocks promoting an outsider into a write-capable role).
        (
          request.auth.uid in resource.data.get('adminUids', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupName','groupPhotoUrl','adminUids']) &&
          request.resource.data.get('adminUids', []).hasOnly(resource.data.participants)
        ) ||
        // (3) Admin removes member(s) — participants may only SHRINK (every
        // new uid already existed). Blocks using this as a back door to add
        // someone without an accepted invite.
        (
          request.auth.uid in resource.data.get('adminUids', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
          resource.data.participants.hasAll(request.resource.data.participants) &&
          request.resource.data.participants.size() < resource.data.participants.size()
        ) ||
        // (4) Any current participant removes ONLY themselves (leave).
        (
          request.auth.uid in resource.data.participants &&
          !(request.auth.uid in request.resource.data.participants) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
        ) ||
        // (5) A non-participant adds ONLY themselves, only with an accepted invite.
        (
          !(request.auth.uid in resource.data.participants) &&
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
          get(/databases/$(database)/documents/groupInvites/$(chatId + '_' + request.auth.uid)).data.status == 'accepted'
        )
      );

      match /messages/{messageId} {
        allow read: if isSignedIn()
                     && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                       && request.auth.uid == request.resource.data.senderId
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Sender may edit/delete their own message as before. ANY current
        // participant may additionally react — restricted to touching only
        // the reactions field, and only their own key within it.
        allow update: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
            request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          )
        );
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── YoloAIO: group chat invite/accept/decline handshake ───────────
    // Deterministic id (chatId_invitedUid) so this rule and the chats/
    // {chatId} update rule's clause (5) can each reference one specific
    // invite doc by constructing its path, with no Cloud Function.
    match /groupInvites/{inviteId} {
      // Same `resource == null ||` guard as chats/{chatId} above — without
      // it, GroupChatRepository.inviteMembers()'s existence-check (getDoc,
      // to decide create-vs-delete-then-recreate) throws "Missing or
      // insufficient permissions" for every brand-new invitee, since their
      // invite doc has never existed yet. This was the actual bug behind
      // the "invite modal won't close" / "no pending status shown" report
      // — inviteMembers() threw on the very first uid in the loop, before
      // ever reaching the create() call.
      allow read: if isSignedIn() && (resource == null || request.auth.uid == resource.data.invitedUid || request.auth.uid == resource.data.invitedByUid);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.invitedByUid
        && request.resource.data.status == 'pending'
        && inviteId == request.resource.data.chatId + '_' + request.resource.data.invitedUid
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.get('adminUids', []);
      allow update: if isSignedIn() && request.auth.uid == resource.data.invitedUid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','declined'];
      // Inviter cancels a pending invite, or clears a declined one to
      // re-invite later (re-invite = delete-then-create, since create
      // fails on an already-existing doc id). Deliberately blocked once accepted.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.invitedByUid && resource.data.status != 'accepted';
    }

    // ── YoloAIO: public quote wall ───────────────────────────────────
    match /publicQuotes/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ── YoloAIO: community channel ───────────────────────────────────
    match /communityMessages/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // ── YoloAIO: remote feature flags + API keys ─────────────────────
    // Readable by any signed-in user. Writes are admin-only — used by the
    // in-app "Menu Access" settings panel (config/app.menuMinRole), which
    // needs real write access unlike the original Console-only rule.
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── YoloAIO: WalkieTalkie channel codes + WebRTC signaling ────────
    // Any signed-in user may fetch ONE specific channel doc by code (the
    // normal Receive flow — you already have the code) or claim one
    // (create, with themselves as ownerUid). Only admins may LIST/query
    // the collection (e.g. "all channels where live == true") — this is
    // what lets the admin-only "live channels" browser in the app find
    // active broadcasts without already knowing their codes; a non-admin
    // user cannot discover other people's channels this way even though
    // they could still join one if told the code directly. Only the
    // owner may update/delete the channel doc itself (live flag,
    // heartbeat, refresh). Session docs (offer/answer) and their
    // ICE-candidate subcollections are writable by either the receiver
    // (their own uid) or the channel's owner (the transmitter answering
    // them).
    match /walkieChannels/{code} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /sessions/{receiverUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
          (request.auth.uid == receiverUid ||
           get(/databases/$(database)/documents/walkieChannels/$(code)).data.ownerUid == request.auth.uid);

        match /{candidateCollection}/{candidateId} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() &&
            (request.auth.uid == receiverUid ||
             get(/databases/$(database)/documents/walkieChannels/$(code)).data.ownerUid == request.auth.uid);
        }
      }
    }

    // ── YoloAIO: MindMatch pairing codes + quiz answers ───────────────
    // A session doc is created by exactly one host (create requires
    // hostUid == the writer, guestUid == ''). A second person may claim
    // the open guest slot exactly once (guestUid must currently be blank,
    // the claimant can't be the host, and the claim may only touch
    // guestUid/guestDisplayName/updatedAt — not either answers array).
    // After that, the host may only write hostAnswers (+ updatedAt) and
    // the guest may only write guestAnswers (+ updatedAt) — each side is
    // structurally unable to touch the other's answer field. This is not
    // airtight against a party re-submitting their OWN answers a second
    // time (same pragmatic level as walkieChannels' owner being able to
    // rewrite `live`/heartbeat anytime) — that's prevented client-side by
    // UI state, not by the rules. No `list` — codes are shared out of
    // band (chat invite / typed in), never browsed.
    match /mindMatchSessions/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.hostAnswers == []
        && request.resource.data.guestAnswers == [];

      allow update: if isSignedIn() && (
        (
          resource.data.guestUid == '' &&
          request.auth.uid != resource.data.hostUid &&
          request.resource.data.guestUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestUid', 'guestDisplayName', 'updatedAt'])
        ) ||
        (
          request.auth.uid == resource.data.hostUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hostAnswers', 'updatedAt'])
        ) ||
        (
          request.auth.uid == resource.data.guestUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestAnswers', 'updatedAt'])
        )
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.hostUid;
    }
  }
}
