// REFERENCE COPY — not the deploy source.
//
// This Firestore project (yolohome-c2ce4, see app/google-services.json) is
// shared between Yolo-Home and YoloAIO — one Firestore database behind
// both apps. The rules file that actually deploys lives at
// ../Yolo-Homes-Android/firestore.rules (wired up via that repo's
// firebase.json + `firebase deploy --only firestore:rules`). This copy is
// kept here purely so YoloAIO's own rules are visible from this repo —
// edit the Yolo-Homes-Android copy (and copy the change back here) rather
// than editing this file in isolation, or the two will drift out of sync.

rules_version = '2';

// Shared by Yolo-Home (apartment app) and YoloAIO (all-in-one).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'developer']
        )
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Shared: user profile (used by BOTH apps) ─────────────────────
    // Outer read/write semantics match Yolo-Home's existing rule exactly.
    // YoloAIO's per-user subcollections live inside.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);

      // YoloAIO private subcollections — owner only.
      match /watchHistory/{tmdbId}      { allow read, write: if isOwner(uid); }
      match /customQuotes/{quoteId}     { allow read, write: if isOwner(uid); }
      match /favoriteWallpapers/{id}    { allow read, write: if isOwner(uid); }
      match /favoriteRingtones/{id}     { allow read, write: if isOwner(uid); }
      match /favoriteTracks/{id}        { allow read, write: if isOwner(uid); }
      match /favoriteBooks/{id}         { allow read, write: if isOwner(uid); }
      match /favoriteHairstyles/{id}    { allow read, write: if isOwner(uid); }
      match /settings/{settingName}     { allow read, write: if isOwner(uid); }
    }

    // ── Yolo-Home: apartment collections (unchanged) ─────────────────
    match /appSettings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /masterFlats/{flatId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /flats/{flatId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /maintenanceSettings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /maintenanceReceipts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /readings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── YoloAIO: chat (1:1 DMs, gated on participants array) ─────────
    match /chats/{chatId} {
      allow read:   if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                     && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                       && request.auth.uid == request.resource.data.senderId
                       && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── YoloAIO: public quote wall ───────────────────────────────────
    match /publicQuotes/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ── YoloAIO: community channel ───────────────────────────────────
    match /communityMessages/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // ── YoloAIO: remote feature flags + API keys ─────────────────────
    // Readable by any signed-in user. Writes are admin-only — used by the
    // in-app "Menu Access" settings panel (config/app.menuMinRole), which
    // needs real write access unlike the original Console-only rule.
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── YoloAIO: WalkieTalkie channel codes + WebRTC signaling ────────
    // Any signed-in user may fetch ONE specific channel doc by code (the
    // normal Receive flow — you already have the code) or claim one
    // (create, with themselves as ownerUid). Only admins may LIST/query
    // the collection (e.g. "all channels where live == true") — this is
    // what lets the admin-only "live channels" browser in the app find
    // active broadcasts without already knowing their codes; a non-admin
    // user cannot discover other people's channels this way even though
    // they could still join one if told the code directly. Only the
    // owner may update/delete the channel doc itself (live flag,
    // heartbeat, refresh). Session docs (offer/answer) and their
    // ICE-candidate subcollections are writable by either the receiver
    // (their own uid) or the channel's owner (the transmitter answering
    // them).
    match /walkieChannels/{code} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /sessions/{receiverUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
          (request.auth.uid == receiverUid ||
           get(/databases/$(database)/documents/walkieChannels/$(code)).data.ownerUid == request.auth.uid);

        match /{candidateCollection}/{candidateId} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() &&
            (request.auth.uid == receiverUid ||
             get(/databases/$(database)/documents/walkieChannels/$(code)).data.ownerUid == request.auth.uid);
        }
      }
    }

    // ── YoloAIO: MindMatch pairing codes + quiz answers ───────────────
    // A session doc is created by exactly one host (create requires
    // hostUid == the writer, guestUid == ''). A second person may claim
    // the open guest slot exactly once (guestUid must currently be blank,
    // the claimant can't be the host, and the claim may only touch
    // guestUid/guestDisplayName/updatedAt — not either answers array).
    // After that, the host may only write hostAnswers (+ updatedAt) and
    // the guest may only write guestAnswers (+ updatedAt) — each side is
    // structurally unable to touch the other's answer field. This is not
    // airtight against a party re-submitting their OWN answers a second
    // time (same pragmatic level as walkieChannels' owner being able to
    // rewrite `live`/heartbeat anytime) — that's prevented client-side by
    // UI state, not by the rules. No `list` — codes are shared out of
    // band (chat invite / typed in), never browsed.
    match /mindMatchSessions/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.hostAnswers == []
        && request.resource.data.guestAnswers == [];

      allow update: if isSignedIn() && (
        (
          resource.data.guestUid == '' &&
          request.auth.uid != resource.data.hostUid &&
          request.resource.data.guestUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestUid', 'guestDisplayName', 'updatedAt'])
        ) ||
        (
          request.auth.uid == resource.data.hostUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hostAnswers', 'updatedAt'])
        ) ||
        (
          request.auth.uid == resource.data.guestUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestAnswers', 'updatedAt'])
        )
      );

      allow delete: if isSignedIn() && request.auth.uid == resource.data.hostUid;
    }
  }
}
